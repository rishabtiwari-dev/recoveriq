# RecoverIQ Environment Configuration Example
# (Secrets / API keys are kept separate from deterministic policy configuration)

# Environment
RECOVERIQ_ENV=development
LOG_LEVEL=INFO

# Gemini LLM Context Layer (Sprint 3)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=5.0
